# Production environment variables for split-domain Docker Compose deployment
# Copy to .env and fill in real values before deploying

# PostgreSQL (or Azure Database for PostgreSQL)
DATABASE_URL="postgresql://quizuser:quizpass@postgres:5432/quizdb?schema=public"

# Iron Session secret (generate with: openssl rand -base64 32)
SESSION_SECRET=""

# Host dashboard password
HOST_PASSWORD=""

# Public domain for the Next.js app
NEXT_PUBLIC_SOCKET_URL="https://socket.pokhrelmilan.com.np"
NEXT_PUBLIC_SOCKET_PATH="/socket.io"

# Internal URL Server Actions use to emit socket events (Docker service name)
SOCKET_EMIT_URL="http://socket:4000/emit"

# Socket.IO CORS: the origin of the browser app (quiz domain)
ALLOWED_ORIGIN="https://quiz.pokhrelmilan.com.np"

# Postgres container credentials
POSTGRES_USER="quizuser"
POSTGRES_PASSWORD="quizpass"
POSTGRES_DB="quizdb"

# Node environment
NODE_ENV="production"
